{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2021",
        "moduleResolution": "node",
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "sourceMap": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "strict": true,
        "skipLibCheck": true,
        "types": [
            "node"
        ],
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "src/**/*.ts"
    ]
}